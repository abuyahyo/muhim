<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism: to'q shaffof asos + yuqoridan yorug'lik gradienti + nozik oq chegara.
     Haqiqiy blur RemoteViews'da mavjud emas — wallpaper ustida muzlatilgan shisha ko'rinish beradi. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#2E0B1220" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:endColor="#08FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
