<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 — Sana + keyingi namoz -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/glass_bg" />

    <LinearLayout    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="center">


    <TextView
        android:id="@+id/dt_weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/dt_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_ink"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dt_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dt_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_dim"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/dt_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
