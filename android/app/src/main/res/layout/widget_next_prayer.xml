<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1 — Keyingi namoz -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/glass_bg" />

    <LinearLayout    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center">


    <TextView
        android:id="@+id/np_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_next_label"
        android:textColor="@color/widget_dim"
        android:textSize="10sp"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/np_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/np_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/np_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_mute"
        android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
